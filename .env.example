# Environment variables for the memory system: a template, not a loaded file.
#
# Nothing reads this file automatically and nothing in it is required for the
# core install. Every line is commented out and shows the built-in default.
# Copy only the lines you want to change into the place that reaches the
# process you mean to configure:
#
#   MCP server (mcp/server.js)
#       the `env` block of the server entry in your client's MCP config.
#   launchd services started through launchd/run-with-env.sh
#   (watermark, git-log-connector, slack-connector) and the telegram capture
#       <MEMORY_ROOT>/config/secrets.env, mode 600. The wrapper refuses a file
#       that group or other can read. Connector credentials go here and
#       nowhere else.
#   every other launchd service (queryd, embed-server, rerank-server,
#   embed-watchdog, reembed-drain, the remaining connectors)
#       the EnvironmentVariables block of its plist template in launchd/.
#
# Values in angle brackets are placeholders to replace. A line left empty in a
# secrets file still exports an empty variable, which can mask a default or
# stop a Python server from starting, so delete or keep commented every line
# you do not use. The full reference, including variables not shown here, is
# docs/ENVIRONMENT.md.

# ---------------------------------------------------------------------------
# Roots and paths
# A per-directory variable wins over MEMORY_ROOT; MEMORY_ROOT wins over the
# checkout. Set MEMORY_ROOT identically for the MCP server and the services.
# ---------------------------------------------------------------------------

# Data root for ledgers, storage, policy, indices and logs. Default: the checkout that contains mcp/.
# MEMORY_ROOT=<path to this checkout>

# Policy state directory.
# POLICY_BASE_DIR=<MEMORY_ROOT>/policy

# Storage directory (source ledgers, caches, queues).
# STORAGE_BASE_DIR=<MEMORY_ROOT>/storage

# Directory holding the memory ledger.
# LEDGERS_BASE_DIR=<MEMORY_ROOT>/ledgers

# Daemon state and log directory.
# DAEMONS_BASE_DIR=<MEMORY_ROOT>/daemons

# Hook state directory.
# HOOKS_BASE_DIR=<MEMORY_ROOT>/hooks

# Per-connector cursor state.
# CONNECTORS_BASE_DIR=<MEMORY_ROOT>/connectors

# Directory of the per-call telemetry file.
# TELEMETRY_BASE_DIR=<MEMORY_ROOT>/telemetry

# Where rows rejected at ingest are kept. Wins over STORAGE_BASE_DIR.
# QUARANTINE_BASE_DIR=<MEMORY_ROOT>/storage/quarantine

# File listing which addresses and handles are you (shape: config/operator-identity.example.json).
# MEMORY_OPERATOR_IDENTITY_FILE=<MEMORY_ROOT>/config/operator-identity.json

# ---------------------------------------------------------------------------
# Server and tools (MCP client config)
# ---------------------------------------------------------------------------

# SAFETY GATE. Launch identity; the distillation-only tools need `distillation`.
# MEMORY_ROLE=agent

# SAFETY GATE. memory_put: 1 forces it on, 0 forces it off. Unset (the default) it is on only for a first run with no vector index.
# MEMORY_PUT_ENABLED=

# Where recall loads its indexes: auto, required (always the queryd daemon) or off (always in-process).
# MEMORY_QUERYD=auto

# Milliseconds the server waits for in-flight tool calls on shutdown.
# MEMORY_MCP_SHUTDOWN_GRACE_MS=5000

# Milliseconds between checks that the parent process is still alive.
# MEMORY_MCP_PPID_POLL_MS=15000

# memory_catchup fast path; set 0 to turn it off.
# CATCHUP_PROJECTION=1

# ---------------------------------------------------------------------------
# Recall and ranking (MCP client config)
# ---------------------------------------------------------------------------

# Rerank with the local reranker (1) or the cloud one (0, needs a Gemini key).
# LOCAL_RERANKER_ENABLED=1

# Reranker base URL. OFF-MACHINE if not loopback: query and memory text are posted to it.
# LOCAL_RERANKER_URL=http://127.0.0.1:8360

# Reranker per-request timeout in milliseconds.
# LOCAL_RERANKER_TIMEOUT_MS=8000

# Embedding server base URL. OFF-MACHINE if not loopback: memory and query text are posted to it.
# LOCAL_EMBED_URL=http://127.0.0.1:8359

# Embedding server per-request timeout in milliseconds.
# LOCAL_EMBED_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Ingest and connectors (secrets.env or the connector's plist template)
# ---------------------------------------------------------------------------

# Colon-separated directories the git-log connector searches. Default: a built-in list under your home directory plus the checkout.
# GIT_LOG_REPO_ROOTS=<dir>:<dir>

# Colon-separated author addresses that count as you.
# GIT_LOG_OPERATOR_EMAILS=alex@example.com:alex@example.org

# Colon-separated glob patterns for Codex CLI session files.
# CODEX_CLI_SESSIONS_GLOB=~/.codex/sessions/*/*/*/rollout-*.jsonl

# Consent basis stamped on Codex sessions; second_party_dm for shared sessions.
# CODEX_CLI_CONSENT_BASIS=first_party

# Working directory recorded for every Codex session. Default: unset (the session's own directory).
# CODEX_CLI_FORCE_CWD=

# Comma-separated Slack workspace ids to ingest. Default: none.
# SLACK_WORKSPACE_IDS=

# Seconds between Slack polls.
# SLACK_POLL_INTERVAL_SECONDS=600

# Slack messages per history page.
# SLACK_HISTORY_PAGE_LIMIT=200

# Slack conversations per listing page.
# SLACK_CONVERSATIONS_PAGE_LIMIT=200

# Telegram session file created by telegram_login.py. TELEGRAM_SESSION_STRING wins if both are set.
# TELEGRAM_SESSION_FILE=~/.config/memory-system/telegram.session

# File the Telegram capture appends to and the connector drains. Contains message text.
# If you set it, give the MCP server process the same value: its Telegram stall detector reads this file and does not see the launchd services' environment.
# TELEGRAM_STAGING_FILE=<MEMORY_ROOT>/storage/tmp/telegram-staging.jsonl

# Comma-separated Telegram channel ids you own; posts from other broadcast channels are dropped. Default: none.
# TELEGRAM_CHANNEL_ALLOWLIST=

# Days a quarantined row is kept.
# QUARANTINE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Embedder, reranker and voice (plist templates of embed-server / rerank-server;
# WHATSAPP_VOICE_STT in the whatsapp-connector plist template)
# Token-count limits are in docs/ENVIRONMENT.md (sequence and batch caps of the
# embedder, pair cap of the reranker); all three default to safe values.
# ---------------------------------------------------------------------------

# Hugging Face model id the embedding server loads.
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Version string stored with each vector; change it whenever you change the model.
# EMBED_MODEL_VERSION=qwen3-embedding-8b-fp16

# Torch device: mps, cuda or cpu. Default: unset (auto-detect in that order).
# EMBED_DEVICE=

# Address and port the embedding server binds. Keep the address on loopback: the server has no authentication.
# EMBED_HOST=127.0.0.1
# EMBED_PORT=8359

# Exit cleanly after this many requests so launchd restarts the server; 0 disables. The shipped plist template sets 128.
# EMBED_RECYCLE_AFTER_REQUESTS=0

# Hugging Face model id the reranker loads.
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# Version string the reranker reports.
# RERANK_MODEL_VERSION=qwen3-reranker-0.6b

# Torch device for the reranker. Default: unset (auto-detect).
# RERANK_DEVICE=

# Address and port the reranker binds. Keep the address on loopback.
# RERANK_HOST=127.0.0.1
# RERANK_PORT=8360

# SAFETY GATE. WhatsApp one-to-one voice notes are transcribed on this machine unless this is 0.
# WHATSAPP_VOICE_STT=1

# Speech-to-text model for voice notes.
# STT_MODEL=mlx-community/whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Daemons (plist templates, or secrets.env for watermark)
# ---------------------------------------------------------------------------

# Most rows the re-embed drain embeds per run. The shipped plist template sets 1000.
# REEMBED_BATCH=200

# How the drain finds rows that lack a vector: sweep or ledger.
# REEMBED_WORK_SET=sweep

# Comma-separated model versions queryd serves. Default: the local model plus the legacy cloud model; the shipped plist template sets the value below.
# QUERYD_MODEL_VERSIONS=qwen3-embedding-8b-fp16

# SAFETY GATE. Set 1 to suspend thread and project aggregation in the watermark daemon. Default: unset (aggregation runs).
# MEMORY_WATERMARK_PAUSE_SYNTHESIS=

# ---------------------------------------------------------------------------
# Cloud keys (never a plist)
# OFF-MACHINE: each of these makes a process talk to a third party. Leave them
# out for a local-only install.
# The two Gemini keys are read only by the MCP server's cloud reranker
# (mcp/lib/recall/rerank.js, used only with LOCAL_RERANKER_ENABLED=0) and by the
# manual scripts/backfill-embeddings.mjs: put them in the `env` block of the MCP
# client registration, or the shell you run that script from. No service reads
# them from secrets.env. The Slack and Telegram credentials below go in
# secrets.env (mode 600).
# ---------------------------------------------------------------------------

# Comma-separated Gemini API key pool (MCP server env). Wins over the single key below.
# GEMINI_API_KEYS=

# Single Gemini API key (MCP server env). Ignored when the pool above is set.
# GEMINI_API_KEY=

# Slack user token the connector reads your workspaces with.
# SLACK_USER_TOKEN=

# Slack API base URL; change only to point at a test server you control.
# SLACK_API_BASE=https://slack.com/api

# Numeric id of your own Telegram application.
# TELEGRAM_API_ID=

# API hash that pairs with the Telegram application id.
# TELEGRAM_API_HASH=

# A Telegram login session as a string: a full credential for your account. Wins over the session file.
# TELEGRAM_SESSION_STRING=

# ---------------------------------------------------------------------------
# Testing and diagnostics
# ---------------------------------------------------------------------------

# Set 1 to print per-stage recall timing to stderr. Default: unset.
# RECALL_PROF=

# Size in bytes at which the per-call telemetry file is rotated.
# TELEMETRY_MAX_BYTES=33554432
